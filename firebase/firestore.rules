rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 収集3の共有。合言葉（2文字以上）ごとに1日1つの文書。合言葉を知っている人は誰でも読み書きできる
    // ログインは無し。合言葉そのものが鍵。消すことはできない（日付が変われば次の文書に移るだけ）
    match /rooms/{room}/days/{day} {
      allow read: if room.size() >= 2;
      allow create, update: if room.size() >= 2 && room.size() <= 64
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().size() <= 21;
    }
    // ほかの場所は誰も触れない
  }
}
